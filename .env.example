# Public web client
WEB_HOST=127.0.0.1
WEB_PORT=5555
PUBLIC_API_BASE_URL=http://127.0.0.1:3333
PUBLIC_BASE_PATH=/

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5555
MAX_JSON_BODY_BYTES=2097152
API_REPOSITORY_DRIVER=postgres
DATABASE_URL=postgresql://bedroom:change-me@127.0.0.1:5432/bedroom

# Identity. Development mode accepts explicit x-user/tenant/workspace headers.
# Production must use oidc and must not trust those headers.
AUTH_MODE=development
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=bedroom-layout-studio
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Object storage
STORAGE_DRIVER=filesystem
STORAGE_ROOT=/srv/bedroom-layout-studio/dev-storage
# S3_BUCKET=bedroom-assets
# S3_REGION=auto
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false

# Agent control and worker. Replace the token with at least 32 random bytes.
AGENT_QUEUE_DRIVER=pg-boss
AGENT_WORKER_TOKEN=replace-with-a-long-random-capability-token
AGENT_WORKER_CONCURRENCY=1
API_INTERNAL_BASE_URL=http://127.0.0.1:3333
AGENT_EXECUTION_MODE=mock
AGENT_WORKSPACE_ROOT=/srv/bedroom-layout-studio/agent-workspaces
AGENT_REPOSITORY_ROOT=/opt/bedroom-layout-studio
AGENT_REPOSITORY_REVISION=HEAD
AGENT_TASK_TIMEOUT_MS=3600000
ALLOW_UNTRUSTED_SOURCE=false
# CODEX_BINARY=codex
# CODEX_MODEL=
