{
  "name": "bedroom-layout-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @bedroom/web",
    "dev:api": "npm run dev --workspace @bedroom/api",
    "dev:worker": "npm run dev --workspace @bedroom/agent-worker",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build:web:sites",
    "build:web:sites": "npm run build --workspace @bedroom/web",
    "build:web:pages": "npm run build:pages --workspace @bedroom/web",
    "build:api": "npm run build --workspace @bedroom/api",
    "build:worker": "npm run build --workspace @bedroom/agent-worker",
    "build:packages": "npm run build --workspace @bedroom/contracts --workspace @bedroom/bedroom-core --workspace @bedroom/furniture-assets --workspace @bedroom/database --workspace @bedroom/storage",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "assets:sync": "npm run assets:sync --workspace @bedroom/web",
    "assets:check": "npm run assets:check --workspace @bedroom/web",
    "deploy:web:sites": "npm run deploy:sites --workspace @bedroom/web",
    "deploy:web:pages": "npm run deploy:pages --workspace @bedroom/web"
  },
  "displayName": "卧室布局工作台"
}
